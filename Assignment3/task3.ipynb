    "gst = lambda price : price + price * 0.18 \n",
    "final_price = lambda price , discount : (price - price * discount/100 ) * 1.18\n",
    "\n",
    "\n",
    "print(gst(100))\n",
    "print(final_price(1000, 10))"
   ]
