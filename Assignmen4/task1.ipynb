    "sales = [1200 , 450 , 980 , 1500 , 3000]\n",
    "\n",
    "with open(\"sales_data.txt\", 'w') as file : \n",
    "    for sale in sales : \n",
    "        file.write(str(sale) + \"\\n\")\n",
    "\n",
    "with open(\"sales_data.txt\" , 'r') as file1 : \n",
    "    content = file1.read() \n",
    "\n",
    "print(content)"
