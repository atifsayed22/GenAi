   ],
   "source": [
    "daily = [ 200 , 150 , 0 , 400 , 50 , -1 , 300 ]\n",
    "\n",
    "total = 0 \n",
    "\n",
    "for revenue in daily :\n",
    "\n",
    "    if revenue < 0 : \n",
    "        break\n",
    "    elif revenue == 0 : \n",
    "        continue\n",
    "    else :\n",
    "        total += revenue\n",
    "\n",
    "print(\"Total revenue: \", total)"
   ]
  }
